# ForgeAI configuration. Copy to .env and fill in. .env is git-ignored - never commit a key.
# Every LLM call goes through forgeai/llm.py using these values (any OpenAI-compatible endpoint).

# ---- Provider: "openai" (any OpenAI-compatible endpoint) or "mock" (offline, deterministic; used by tests)
LLM_PROVIDER=openai

# ---- Preset 1: Groq (free tier; fast). Agent = small open model, judge = a DIFFERENT, larger model.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile
# Groq free tier allows ~30 requests/minute; space calls out to avoid 429s (backoff handles the rest).
LLM_MIN_INTERVAL_S=2.1

# ---- Preset 2: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o
# LLM_MIN_INTERVAL_S=0

# ---- Preset 3: Ollama (local, no key). Pull both models first: ollama pull llama3.1:8b && ollama pull qwen2.5:14b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
# JUDGE_MODEL=qwen2.5:14b
# LLM_MIN_INTERVAL_S=0

# ---- Generation / budget
LLM_TEMPERATURE=0
MAX_TOKENS_PER_RUN=600000
MAX_SECONDS_PER_RUN=3600
# Dev-split score at which the optimizer stops early
TARGET_SCORE=90
LLM_TIMEOUT=60

# ---- Retrieval: auto (fastembed bge-small, falls back to hashed embeddings offline) | fastembed | hash
EMBEDDING_BACKEND=auto

# ---- Where run artifacts go
# RUNS_DIR=./runs
